# Copy to .env and adjust. All values have dev-safe defaults in src/config.ts.

# HTTP port the API listens on.
PORT=3001

# PostgreSQL connection string (NFR-PORT-01: PostgreSQL is the production target).
DATABASE_URL=postgres://localhost:5432/thesis_management

# JWT signing secret — MUST be changed for any non-local deployment (min 16 chars).
JWT_SECRET=dev-only-secret-change-in-production

# Access-token lifetime (FR-AUTH-03: tokens must expire).
JWT_TTL=12h

# Shared password for all seeded demo accounts (argon2-hashed at seed time).
DEMO_PASSWORD=Password123!

# Origin allowed by CORS (the Vite dev server or the deployed web app).
CORS_ORIGIN=http://localhost:5173

# Enables POST /api/v1/admin/reset-demo. Disable outside demos.
ALLOW_DEMO_RESET=true
