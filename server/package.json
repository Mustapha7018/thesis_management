{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Thesis management portal REST API (FR-API-01): versioned JSON API, sole writer to the PostgreSQL database.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts src/ga/ga.worker.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "start": "node dist/index.js",
    "lint": "oxlint src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "drizzle-kit push",
    "db:seed": "tsx src/seed.ts",
    "experiment:sensitivity": "tsx scripts/sensitivity-experiment.ts",
    "experiment:full": "tsx scripts/experiment-runner.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "papaparse": "^5.5.4",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
